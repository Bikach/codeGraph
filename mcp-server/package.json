{
  "name": "@codegraph/mcp-server",
  "version": "2.0.0",
  "description": "MCP Server for CodeGraph - Code analysis and navigation via an embedded knowledge graph",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "benchmark:mcp": "tsx src/benchmark/index.ts mcp",
    "benchmark:native": "tsx src/benchmark/index.ts native",
    "benchmark:report": "tsx src/benchmark/report.ts",
    "bundle": "node esbuild.config.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "codegraph",
    "ladybugdb",
    "code-analysis"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ladybugdb/core": "^0.17.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "graphology": "^0.26.0",
    "graphology-communities-louvain": "^2.0.2",
    "seedrandom": "^3.0.5",
    "tree-sitter": "^0.22.4",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-typescript": "^0.23.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/seedrandom": "^3.0.8",
    "esbuild": "^0.27.2",
    "glob": "^11.0.0",
    "graphology-types": "^0.24.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^4.0.15"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
